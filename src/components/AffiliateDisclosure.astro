---
import { getCollection } from 'astro:content';

// Counted from the collection at build time so the detail can't go stale — a
// hand-written version had already drifted into describing a ranking "nudge"
// that no longer existed.
//
// The `compact` version is the standing site-wide disclosure: one sentence,
// true whether or not any affiliate link exists. The full version is only for
// /about, where detail is what the reader came for.
const tools = await getCollection('tools');
const total = tools.length;
const withAffiliate = tools.filter((t) => t.data.affiliateUrl).length;

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

{
  compact ? (
    <p class="disclosure-compact">
      Some links may earn us a commission. It never affects our rankings.
    </p>
  ) : (
    <div class="disclosure" id="money">
      <h2>How we make money</h2>
      <p>
        Some links on this site may earn us a commission if you sign up through
        them, at no extra cost to you.{' '}
        <strong>It never affects our rankings.</strong> Our scoring has no
        monetization term in it — whether a tool pays us isn't one of the
        inputs, so it can't move a result up or down, or break a tie.
      </p>
      <p>
        {withAffiliate === 0 ? (
          <>
            As it happens, none of the {total} tools we list pays us anything
            today — we aren't in an affiliate programme yet. This page counts
            that from the tool data itself, so it stays accurate.
          </>
        ) : (
          <>
            {withAffiliate} of the {total} tools we list currently use an
            affiliate link, and each is labelled where you click it. This page
            counts that from the tool data itself, so it stays accurate.
          </>
        )}
      </p>
    </div>
  )
}

<style>
  .disclosure {
    scroll-margin-top: 2rem;
  }
  .disclosure-compact {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>
