---
import AffiliateDisclosure from './AffiliateDisclosure.astro';
const year = new Date().getFullYear();
---

<footer class="container site-footer">
  <p class="muted">
    Recommendations reflect our own research and opinion — always double-check
    the details before you buy.
  </p>
  <AffiliateDisclosure compact />
  <p class="footer-links">
    <a href="/about" class="button button-secondary">About</a>
    <a href="/privacy" class="button button-secondary">Privacy</a>
  </p>
  <p class="muted copyright">&copy; {year} AgentLife</p>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }
  .muted {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .muted + .muted {
    margin-top: 0.5rem;
  }
  .footer-links {
    margin-top: 1rem;
  }
  .copyright {
    margin-top: 1rem;
  }
</style>
