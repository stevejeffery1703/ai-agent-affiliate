---
import AffiliateDisclosure from './AffiliateDisclosure.astro';
const year = new Date().getFullYear();
---

<footer class="container site-footer">
  <AffiliateDisclosure compact />
  <p class="footer-links">
    <a href="/tools">All tools</a>
    <a href="/about">How we choose</a>
    <a href="/privacy">Privacy</a>
  </p>
  <p class="muted copyright">&copy; {year} AgentLife</p>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }
  .muted {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .muted + .muted {
    margin-top: 0.5rem;
  }
  .footer-links {
    margin-top: 1rem;
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
  }
  .copyright {
    margin-top: 1rem;
  }
</style>
