---
// The finder is the homepage, so the brand link covers it — a separate "Home"
// and "Find Tools" would both point at `/`.
const links = [
  { href: '/tools', label: 'All tools' },
  { href: '/about', label: 'How we choose' },
];
const path = Astro.url.pathname;
---

<header class="container site-header">
  <a href="/" class="brand">AgentLife</a>
  <nav class="nav">
    {
      links.map((link) => (
        <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .brand {
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--text);
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  /* Text links, not bordered buttons — two outlined pills in the header read
     as calls to action competing with the tool itself. */
  .nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .nav a:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .nav a[aria-current='page'] {
    color: var(--text);
  }
</style>
