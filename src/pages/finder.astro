---
import Base from '../layouts/Base.astro';
import '../styles/recommender.css';
import { getCollection } from 'astro:content';
import { toEngineTool } from '../lib/tools';

// Build-time: pull the validated tool collection and transform each entry into
// the shape the client-side scoring engine expects.
const tools = await getCollection('tools');
const TOOLS = tools.map(toEngineTool);
---

<Base
  title="AI Tool Finder | AgentLife"
  description="Answer four quick questions and get matched with the best AI tools for your tasks, budget, and how hands-off you want to be."
>
  <main class="container">
    <!-- HERO -->
    <section class="section hero">
      <div class="section-center">
        <h1 class="hero-title">See exactly what AI can do for you</h1>
        <p class="hero-subtitle">
          Tell us what you need help with, and we'll match you with the best AI
          tools for your situation.
        </p>
      </div>
    </section>

    <!-- RECOMMENDER -->
    <section class="section">
      <div class="section-wide">
        <div id="recommender" class="card recommender-card">
          <!-- Q1: task -->
          <div class="form-group">
            <label class="form-label"
              ><strong>What do you want AI to take off your plate?</strong></label
            >
            <div class="icon-grid" id="task">
              <button class="icon-option active" data-value="writing">✍️<span>Writing</span></button>
              <button class="icon-option" data-value="email">📧<span>Email</span></button>
              <button class="icon-option" data-value="meetings">📝<span>Meetings</span></button>
              <button class="icon-option" data-value="research">🔍<span>Research</span></button>
              <button class="icon-option" data-value="scheduling">📅<span>Scheduling</span></button>
              <button class="icon-option" data-value="notes">🧠<span>Notes</span></button>
              <button class="icon-option" data-value="automation">⚙️<span>Automation</span></button>
              <button class="icon-option" data-value="coding">💻<span>Coding</span></button>
              <button class="icon-option" data-value="design">🎨<span>Design</span></button>
              <button class="icon-option" data-value="video">🎬<span>Video</span></button>
              <button class="icon-option" data-value="marketing">📈<span>Marketing</span></button>
              <button class="icon-option" data-value="presentations">📊<span>Slides</span></button>
            </div>
          </div>

          <!-- Q2: control -->
          <div class="form-group">
            <label class="form-label"
              ><strong>How much control do you want AI to have?</strong></label
            >
            <div class="slider-group">
              <span>Suggestions</span>
              <input type="range" id="control" min="1" max="4" step="1" value="2" />
              <span>Fully done</span>
            </div>
            <div id="control-label" class="slider-label">Help me decide</div>
          </div>

          <!-- Q3: ease -->
          <div class="form-group">
            <label class="form-label"
              ><strong>How easy do you want your AI tools to be?</strong></label
            >
            <div class="slider-group">
              <span>Simple</span>
              <input type="range" id="ease" min="1" max="3" step="1" value="1" />
              <span>Powerful</span>
            </div>
            <div id="ease-label" class="slider-label">
              Simple and easy (works out of the box)
            </div>
          </div>

          <!-- Q4: free only -->
          <div class="form-group">
            <label class="form-label"><strong>Only show free tools?</strong></label>
            <label class="toggle">
              <input type="checkbox" id="price" />
              <span class="toggle-slider"></span>
            </label>
            <small class="toggle-hint">Off = include paid tools</small>
          </div>

          <button id="runBtn" class="button button-primary button-full">
            Show Recommendations
          </button>
        </div>
      </div>
    </section>

    <!-- RESULTS -->
    <section class="section">
      <div class="section-wide">
        <div id="results"></div>
      </div>
    </section>

    <!-- UPGRADE -->
    <section class="section">
      <div class="section-wide">
        <div id="upgrade-results"></div>
      </div>
    </section>
  </main>
</Base>

<!-- Tool data injected from the content collection (read by recommender.js) -->
<script type="application/json" id="tools-data" set:html={JSON.stringify(TOOLS)}
></script>

<script>
  import { initRecommender } from '../scripts/recommender.js';
  initRecommender();
</script>
