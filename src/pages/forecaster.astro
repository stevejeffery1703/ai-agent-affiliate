---
import Base from '../layouts/Base.astro';
---

<Base
  title="Forecaster | AgentLife"
  description="Coming soon: an interactive planner that shows how much time and money AI agents can save you."
>
  <main class="container">
    <section class="placeholder">
      <h1>The Forecaster</h1>
      <p class="muted">
        Our interactive time &amp; money savings planner is on the way.
      </p>
      <a href="/" class="button button-secondary">Back to home</a>
    </section>
  </main>
</Base>

<style>
  .placeholder {
    text-align: center;
    margin-top: 4rem;
  }
  .muted {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
</style>
