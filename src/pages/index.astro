---
import Base from '../layouts/Base.astro';
---

<Base title="AI for Busy People | Save Time with AI Agents">
  <main class="container">
    <section class="hero">
      <h1>See exactly what AI can take off your plate</h1>
      <p class="subtitle">
        Use our free interactive planner to see how much time, money, and stress
        you can save with AI agents.
      </p>
      <a href="/forecaster" class="button button-primary">Open the Forecaster</a>
    </section>
  </main>
</Base>

<style>
  .hero {
    text-align: center;
    margin-top: 3rem;
  }
  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .subtitle {
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto 2rem;
  }
</style>
