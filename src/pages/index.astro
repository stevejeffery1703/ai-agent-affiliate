---
import Base from '../layouts/Base.astro';
import TaskIcon from '../components/TaskIcon.astro';
import '../styles/pages.css';
import '../styles/recommender.css';
import { getCollection } from 'astro:content';
import { toEngineTool } from '../lib/tools';

const entries = await getCollection('tools');
const TOOLS = entries.map(toEngineTool);

const toolCount = entries.length;
const lastVerified = new Date(
  Math.max(...entries.map((e) => e.data.lastVerified.getTime()))
).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });

// `value` must match the canonical TASKS enum in src/content.config.ts.
const TASK_OPTIONS = [
  { value: 'writing', label: 'Writing', icon: 'pen-line' },
  { value: 'email', label: 'Email', icon: 'mail' },
  { value: 'meetings', label: 'Meetings', icon: 'users' },
  { value: 'research', label: 'Research', icon: 'search' },
  { value: 'scheduling', label: 'Scheduling', icon: 'calendar' },
  { value: 'notes', label: 'Notes', icon: 'notebook-pen' },
  { value: 'automation', label: 'Automation', icon: 'workflow' },
  { value: 'coding', label: 'Coding', icon: 'code' },
  { value: 'design', label: 'Design', icon: 'palette' },
  { value: 'video', label: 'Video', icon: 'video' },
  { value: 'marketing', label: 'Marketing', icon: 'megaphone' },
  { value: 'presentations', label: 'Slides', icon: 'presentation' },
];

// Every refinement is a small closed set, so they're all the same control:
// segmented buttons. Sliders hid these labels behind a drag, and the free-only
// toggle didn't say what "on" meant.
const CONTROL_OPTIONS = [
  { value: '1', label: 'Just suggest' },
  { value: '2', label: 'Help me decide' },
  { value: '3', label: 'Do most of it' },
  { value: '4', label: 'Do it all' },
];
// The axis is how much setup you'll put up with, so all three answer that
// question. "Give me power" answered a different one.
const EASE_OPTIONS = [
  { value: 'easy', label: 'Keep it simple' },
  { value: 'medium', label: 'Some setup' },
  { value: 'advanced', label: 'As much as it takes' },
];
const PRICE_OPTIONS = [
  { value: 'all', label: 'Any price' },
  { value: 'free', label: 'Free only' },
];
---

<Base
  title="AgentLife — Find the AI tools that fit how you work"
  description="Pick what you need done and see the few AI tools worth your time, with the reasoning shown."
>
  <main class="page">
    <section class="lede">
      <h1>AI Tools to Help You Work</h1>
    </section>

    <div class="finder-layout">
      <!-- CONTROLS -->
      <form class="rail" id="recommender" aria-label="Refine recommendations">
        <div class="field">
          <span class="field-lead" id="lbl-task">What do you need done?</span>
          <div class="chips" role="group" aria-labelledby="lbl-task" id="task">
            {
              TASK_OPTIONS.map((opt, i) => (
                <button
                  type="button"
                  class="chip chip-task"
                  data-group="task"
                  data-value={opt.value}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  <TaskIcon name={opt.icon} />
                  {opt.label}
                </button>
              ))
            }
          </div>
        </div>

        {/* Collapsed behind a summary on mobile, always open on desktop. */}
        <button
          type="button"
          class="refine-toggle"
          id="refineToggle"
          aria-expanded="true"
          aria-controls="refine"
        >
          <span class="refine-word">Refine</span>
          <span class="refine-state" id="refineState"></span>
        </button>

        <div class="refine" id="refine">
        <div class="field">
          <span class="field-label" id="lbl-control">How much should it do?</span>
          <div class="chips" role="group" aria-labelledby="lbl-control">
            {
              CONTROL_OPTIONS.map((opt) => (
                <button
                  type="button"
                  class="chip"
                  data-group="control"
                  data-value={opt.value}
                  aria-pressed={opt.value === '2' ? 'true' : 'false'}
                >
                  {opt.label}
                </button>
              ))
            }
          </div>
        </div>

        <div class="field">
          <span class="field-label" id="lbl-ease">How much setup do you want to do?</span>
          <div class="chips" role="group" aria-labelledby="lbl-ease">
            {
              EASE_OPTIONS.map((opt) => (
                <button
                  type="button"
                  class="chip"
                  data-group="ease"
                  data-value={opt.value}
                  aria-pressed={opt.value === 'easy' ? 'true' : 'false'}
                >
                  {opt.label}
                </button>
              ))
            }
          </div>
        </div>

        <div class="field">
          <span class="field-label" id="lbl-price">Price</span>
          <div class="chips" role="group" aria-labelledby="lbl-price">
            {
              PRICE_OPTIONS.map((opt) => (
                <button
                  type="button"
                  class="chip"
                  data-group="price"
                  data-value={opt.value}
                  aria-pressed={opt.value === 'all' ? 'true' : 'false'}
                >
                  {opt.label}
                </button>
              ))
            }
          </div>
        </div>
        </div>
      </form>

      <!-- RESULTS -->
      <div class="results-col">
        <div id="results"></div>
        <div id="upgrade-results"></div>
      </div>
    </div>

    <p class="page-foot">
      {toolCount} tools, scored on one rubric and re-checked {lastVerified}.
      <a href="/about">How we choose</a> · <a href="/tools">Browse all</a>
    </p>
  </main>
</Base>

<!-- Tool data injected from the content collection (read by recommender.js) -->
<script type="application/json" id="tools-data" set:html={JSON.stringify(TOOLS)}
></script>

<script>
  import { initRecommender } from '../scripts/recommender.js';
  initRecommender();
</script>
