---
import Base from '../layouts/Base.astro';
---

<Base title="AgentLife — Find the AI tools that fit how you work">
  <main class="container">
    <section class="hero">
      <h1>Find the right AI tools for the way you work</h1>
      <p class="subtitle">
        Answer a few quick questions and get matched with the AI tools that
        actually fit your tasks, your budget, and how hands-off you want to be.
      </p>
      <a href="/finder" class="button button-primary">Find your tools</a>
    </section>
  </main>
</Base>

<style>
  .hero {
    text-align: center;
    margin-top: 3rem;
  }
  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .subtitle {
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto 2rem;
  }
</style>
