---
import Base from '../layouts/Base.astro';
---

<Base title="Privacy | AgentLife" description="Privacy policy for AgentLife.">
  <main class="container">
    <section class="prose">
      <h1>Privacy</h1>
      <p class="muted">
        A full privacy policy is coming soon. In short: we aim to collect as
        little as possible, and any affiliate links are clearly disclosed.
      </p>
    </section>
  </main>
</Base>

<style>
  .prose {
    max-width: 700px;
    margin: 3rem auto 0;
  }
  .muted {
    color: var(--text-muted);
  }
</style>
