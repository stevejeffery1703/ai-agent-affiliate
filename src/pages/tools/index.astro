---
import Base from '../../layouts/Base.astro';
---

<Base
  title="AI Agent Tools | AgentLife"
  description="Coming soon: our curated directory of AI agent tools for busy people."
>
  <main class="container">
    <section class="placeholder">
      <h1>AI Agent Tools</h1>
      <p class="muted">
        Our curated, regularly updated tool directory is coming soon.
      </p>
      <a href="/" class="button button-secondary">Back to home</a>
    </section>
  </main>
</Base>

<style>
  .placeholder {
    text-align: center;
    margin-top: 4rem;
  }
  .muted {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
</style>
